# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / Supabase)
# DATABASE_URL: Connection pooler URL (e.g., PgBouncer port 6543)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct database connection URL for migrations (port 5432)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Client & App URLs
# FRONTEND_URL: Allowed origin for CORS & cookie settings (e.g., http://localhost:5173 or https://launch-lens-beta.vercel.app)
FRONTEND_URL=http://localhost:5173
# APP_URL: Base URL used to construct campaign public tracking links (/r/:slug)
APP_URL=http://localhost:5000

# AI Provider API Keys (Multi-Provider Fallback: Gemini -> Groq -> Mistral)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
